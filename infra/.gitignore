# Terraform working directory and provider binaries — regenerated by `terraform init`,
# should never be committed. (.terraform.lock.hcl is NOT here — that one's small text and
# should be committed, it pins exact provider versions for reproducibility.)
.terraform/

# State — lives in the S3 backend (environments/*) or is bootstrap's own local state
# (bootstrap/), neither belongs in git. See infra/README.md for why.
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real per-environment values (your IP, etc.) — .tfvars.example is the committed template.
*.tfvars
!*.tfvars.example

override.tf
override.tf.json
